# Application
APP_NAME=Darukaa Biodiversity Intelligence Agent
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+psycopg://darukaa:darukaa@postgres:5432/darukaa

# LLM (optional — extraction and phrasing still work without a key)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Embeddings: hashing (no download) or sentence-transformers
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Retrieval
RETRIEVAL_CONFIG_PATH=config/retrieval.yaml
RELATIONSHIP_GRAPH_PATH=config/environmental_graph.yaml
INTERVENTIONS_PATH=config/interventions.yaml

# Security
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080
